{
  "app": {
    "listenPort": 8788,
    "historyLimit": 16,
    "workspaceDir": "."
  },
  "brain": {
    "mode": "openai-compatible",
    "systemPrompt": "You are Kroosbot. Be practical, truthful, and careful with actions.",
    "historyWindow": 10,
    "echoPrefix": "Kroosbot:",
    "tools": {
      "enabled": true,
      "maxSteps": 3
    },
    "openAiCompatible": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "your-model-name",
      "apiKey": "",
      "temperature": 0.2,
      "maxOutputTokens": 300,
      "requestTimeoutMs": 60000
    }
  },
  "memory": {
    "enabled": true,
    "rootDir": "./memory",
    "indexFile": "MEMORY.md",
    "maxResults": 4,
    "maxSnippetChars": 600,
    "autoRemember": {
      "enabled": true,
      "categories": ["preference", "decision"]
    }
  },
  "agents": {
    "enabled": true,
    "rootDir": "./kroosbot-data/agents",
    "defaultAgentId": "",
    "seed": []
  },
  "initiative": {
    "enabled": true,
    "cron": "*/2 * * * *",
    "heartbeatIntervalMs": 120000,
    "autoReviewReadyJobs": true,
    "notifyBlockedJobs": true
  },
  "fitness": {
    "enabled": true,
    "rootDir": "./kroosbot-data/fitness",
    "defaultTimezone": "America/Chicago"
  },
  "conversations": {
    "enabled": true,
    "rootDir": "./kroosbot-data/conversations",
    "historyLimit": 10
  },
  "runtimeStore": {
    "enabled": true,
    "dbPath": "./kroosbot-data/runtime.sqlite"
  },
  "jobs": {
    "enabled": true,
    "rootDir": "./kroosbot-data/jobs",
    "defaultRuntime": "pi",
    "defaultProvider": "lmstudio",
    "defaultModel": "deepseek/deepseek-r1-0528-qwen3-8b",
    "defaultTimeoutMs": 3600000,
    "maxConcurrentJobs": 1,
    "heartbeatIntervalMs": 15000,
    "staleHeartbeatMs": 120000,
    "runtimeCommand": "pi",
    "runtimeArgs": [],
    "runtimeUsePty": true,
    "checks": {
      "commands": ["bun run build"]
    }
  },
  "adapters": {
    "discord": {
      "enabled": false,
      "token": "",
      "requireMention": true,
      "allowedChannelIds": [],
      "mentionRoleIds": []
    },
    "imessage": {
      "enabled": true,
      "serverUrl": "http://127.0.0.1:1234",
      "password": "change-me",
      "webhookPath": "/imessage/webhook",
      "requestTimeoutMs": 10000,
      "markAsRead": false,
      "sendTyping": true
    }
  }
}
